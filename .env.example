# Deployer keys (one per environment; the same key is used on every chain in that environment)
MAINNET_PRIVATE_KEY=
TESTNET_PRIVATE_KEY=

# Etherscan V2 API key; one key covers Ethereum, Base and BSC (mainnet and testnet)
ETHERSCAN_API_KEY=

# Optional RPC overrides
MAINNET_RPC_URL=
BASE_RPC_URL=
BSC_RPC_URL=
SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
BSC_TESTNET_RPC_URL=
